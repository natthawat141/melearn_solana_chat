# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
._*
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# local database and session secret
/data
/agent-tools

# Local compatibility alias, never a second checkout
/melearn_solana_chat

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private Cloudflare imports and local bindings
/cloudflare/imports/
.dev.vars
.dev.vars.*
.wrangler/
.open-next/

# Credentials, database backups, and private exports
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
secrets.json
secrets.*.json
