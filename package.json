{
  "name": "melearn-chat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build --turbopack",
    "start": "node scripts/run-next.mjs start",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview --config wrangler.jsonc",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy --config wrangler.jsonc",
    "upload:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare upload --config wrangler.jsonc",
    "cf:typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:public": "node scripts/check-public-repo.mjs",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:export:cloudflare": "node scripts/export-cloudflare-data.mjs"
  },
  "dependencies": {
    "@firebase/app": "^0.16.2",
    "@firebase/auth": "^1.13.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana/kit": "^8.3.0",
    "@solana/wallet-standard-util": "^1.1.4",
    "@wallet-standard/app": "^1.1.1",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ethers": "^6.17.0",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.0",
    "siwe": "^3.0.0",
    "tw-animate-css": "^1.4.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.145.0"
  }
}
