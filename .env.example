# OpenRouter key from https://openrouter.ai/keys
# If empty, Melearn uses the lesson tutor on the server.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-6-luna-pro

# Solana devnet only. Do not point this MVP at mainnet.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public demo recipient. Override with your own devnet address if you want the SOL.
PAYMENT_RECIPIENT=CByHmPLFQsDEoa8WvEGozBjfgMrHx36eGczvsiyCTRbS

# Optional. A random secret is created in data/session.secret on first run.
SESSION_SECRET=
DATABASE_PATH=data/melearn.db

# Wallet login is verified locally (MetaMask, Phantom, Solflare).
# Required in production: your exact public HTTPS origin, with no trailing slash.
# Leave empty locally to allow http://127.0.0.1:43123 and http://localhost:43123.
WALLET_AUTH_ORIGIN=

# Optional Tavily Search API key; kept server-side. AI searches when a question asks for current facts or sources.
TAVILY_API_KEY=

# Optional Supadata key; kept server-side. When a chat message contains a YouTube link, existing captions are sent to the model as untrusted context.
SUPADATA_API_KEY=

# Resend API key for Email Verification & Password Reset
RESEND_API_KEY=
EMAIL_FROM="Melearn Chat <auth@melearn.io>"
